# Telegram Bot Settings (Exclusive Notifier)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Worker Proxy & 24/7 Telegram Control Panel Sync
CLOUDFLARE_PROXY_URL=https://your-worker.your-subdomain.workers.dev
CLOUDFLARE_SYNC_KEY=
ENABLE_MULTI_USER=True

# Cloudflare Worker Auto-Deploy (Optional for CI/CD or scripts/deploy_worker.py)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=real-estate-db
# ScraperAPI (Alternative fallback proxy)
SCRAPER_API_KEY=

# Polling Interval (seconds)
CHECK_INTERVAL_SECONDS=180

# Logging & Performance
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_DELAY_SECONDS=0.5
LOG_LEVEL=INFO
ENABLE_CONSOLE_NOTIFICATIONS=True
BARGAIN_DISCOUNT_THRESHOLD_PCT=15.0

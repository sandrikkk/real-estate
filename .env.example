# NTFY Notification Settings
# Choose any unique topic name (e.g. my_apartments_tbilisi_9911)
NTFY_TOPIC=
NTFY_SERVER_URL=https://ntfy.sh
# Optional auth token if topic is password protected
NTFY_AUTH_TOKEN=

# Optional Telegram Settings (Optional secondary notifier)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Worker Proxy (100k free req/day for Cloudflare bypass on Cloud runners)
CLOUDFLARE_PROXY_URL=https://your-worker.your-subdomain.workers.dev
# ScraperAPI (Alternative fallback proxy)
SCRAPER_API_KEY=

# Polling Interval (seconds)
CHECK_INTERVAL_SECONDS=180

# Logging & Performance
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_DELAY_SECONDS=0.5
LOG_LEVEL=INFO
ENABLE_CONSOLE_NOTIFICATIONS=True
BARGAIN_DISCOUNT_THRESHOLD_PCT=15.0

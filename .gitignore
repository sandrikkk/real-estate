# Python cache and environments
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Environment files and credentials (CRITICAL: never commit secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*
credentials*.json
client_secrets*.json
service_account*.json

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local database and caches (Cloudflare D1 used in production)
data/*.db
data/*.db-journal
data/*.txt
data/*.json
data/*.tmp

# Cloudflare Wrangler local config and ephemeral secrets (never commit resource IDs or .dev.vars)
cloudflare/wrangler.toml
!cloudflare/wrangler.toml.example
.dev.vars
.dev.vars.*
.wrangler/
uv.lock
